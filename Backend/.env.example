# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Backend HTTP port for local development (deployment platforms provide PORT)
PORT=3000

# Comma-separated frontend origins allowed to call this API.
# Include your deployed Netlify/Vercel frontend origin here, for example:
# FRONTEND_URL=https://coderabbit-wine.netlify.app,https://coderabbit-wine.vercel.app
FRONTEND_URL=http://localhost:5173

# Use a long, random value in production
JWT_SECRET=replace-with-a-long-random-secret

# Google AI Studio API key
GOOGLE_GENAI_API_KEY=your-google-ai-studio-api-key

# Optional: defaults to gemini-3.5-flash when omitted
GEMINI_MODEL=gemini-3.5-flash
